---
layout: layouts/base.njk
---
<article class="h-entry">
  <header class="post-header">
    <h1 class="p-name">{{ title }}</h1>
    <div class="post-meta">
      <time class="dt-published" datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% if tags %}
        &middot;
        {% for tag in tags %}{% if tag != section %}<span>{{ tag }}</span>{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}
      {% endif %}
      &middot;
      <span>by <a class="p-author h-card" href="{{ site.url }}">{{ site.author.name }}</a></span>
    </div>
  </header>

  <div class="post-body e-content">
    {{ content | safe }}
  </div>

  <footer class="post-footer">
    <p>
      <a href="/{{ section }}/">← Back to {{ section }}</a>
    </p>
    <p>
      <a href="/{{ section }}/feed.xml">Subscribe via RSS</a> &middot;
      <a href="/{{ section }}/feed.json">JSON Feed</a>
    </p>
  </footer>
</article>
